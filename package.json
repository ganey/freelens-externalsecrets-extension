{
  "name": "freelens-externalsecrets-extension",
  "version": "1.0.1",
  "publisher": "ganey",
  "description": "Freelens extension for External Secrets Operator",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ganey/freelens-externalsecrets-extension.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/main.js",
  "renderer": "dist/renderer.js",
  "files": [
    "dist/**/*"
  ],
  "engines": {
    "freelens": "^2.0.0",
    "node": ">= 22.0.0"
  },
  "type": "module",
  "scripts": {
    "type:check": "tsc --noEmit -p tsconfig.json --composite false",
    "build": "npm run type:check && vite build && vite build --mode main",
    "dev:main": "vite build --watch --mode main",
    "dev:renderer": "vite build --watch --no-emptyOutDir",
    "pack:dev": "npm version prerelease --preid dev --no-git-tag-version && npm run build && npm pack",
    "test": "jest"
  },
  "dependencies": {},
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^7.29.0",
    "@freelensapp/extensions": "^2.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/jest": "^29.0.0",
    "@types/node": "~22.19.11",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.1.3",
    "electron": "^44.10.0",
    "esbuild": "^0.25.0",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.0.0",
    "mobx": "^7.0.6",
    "mobx-react": "^10.0.2",
    "prettier": "^3.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "5.9.3",
    "vite": "^7.3.1"
  }
}
