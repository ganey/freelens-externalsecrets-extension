{
  "name": "freelens-externalsecrets-extension",
  "version": "0.3.2",
  "publisher": "ganey",
  "description": "Freelens extension for External Secrets Operator",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ganey/freelens-externalsecrets-extension.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "out/main/index.js",
  "renderer": "out/renderer/index.js",
  "files": [
    "out/**/*"
  ],
  "engines": {
    "freelens": "^2.0.0",
    "node": ">= 22.0.0"
  },
  "scripts": {
    "type:check": "tsc --noEmit -p tsconfig.json --composite false",
    "build": "npm run type:check && electron-vite build",
    "build:force": "electron-vite build",
    "pack:dev": "npm version prerelease --preid dev --no-git-tag-version && npm run build && npm pack",
    "test": "jest"
  },
  "dependencies": {
    "mobx": "6.13.7",
    "mobx-react": "7.6.0"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^7.29.0",
    "@freelensapp/extensions": "^2.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/jest": "^29.0.0",
    "@types/node": "~22.19.11",
    "@types/react": "^17.0.90",
    "@types/react-dom": "^17.0.0",
    "@vitejs/plugin-react": "^5.1.3",
    "electron": "^45.1.0",
    "electron-vite": "^5.0.0",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.0.0",
    "prettier": "^3.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sass": "^1.97.3",
    "ts-jest": "^29.0.0",
    "typescript": "5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-external": "^6.2.2",
    "vite-plugin-sass-dts": "^1.3.35"
  }
}
